{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "base",     "name": "Morning mist", "color": "#F3F5F1" },
				{ "slug": "contrast", "name": "Ink",          "color": "#18211C" },
				{ "slug": "accent-1", "name": "Hill green",   "color": "#3D6B45" },
				{ "slug": "accent-2", "name": "Fern wash",    "color": "#E4ECE2" },
				{ "slug": "accent-3", "name": "Forest night", "color": "#1C3328" },
				{ "slug": "accent-4", "name": "Moss grey",    "color": "#56645A" },
				{ "slug": "accent-5", "name": "White",        "color": "#FFFFFF" },
				{ "slug": "accent-6", "name": "Hairline",     "color": "#D3DCD2" },
				{ "slug": "lake",     "name": "Lake blue",    "color": "#2C5A6E" },
				{ "slug": "sun",      "name": "Sunrise",      "color": "#E8B04B" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Bricolage Grotesque",
					"slug": "bricolage",
					"fontFamily": "\"Bricolage Grotesque\", system-ui, sans-serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/BricolageGrotesque-Variable.woff2" ],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Bricolage Grotesque",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"name": "Figtree",
					"slug": "figtree",
					"fontFamily": "Figtree, system-ui, sans-serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/Figtree-Variable.woff2" ],
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"fontFamily": "Figtree",
							"fontDisplay": "swap"
						},
						{
							"src": [ "file:./assets/fonts/Figtree-Variable-Italic.woff2" ],
							"fontWeight": "300 900",
							"fontStyle": "italic",
							"fontFamily": "Figtree",
							"fontDisplay": "swap"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small",    "name": "Small",    "size": "0.9rem",  "fluid": false },
				{ "slug": "medium",   "name": "Medium",   "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large",    "name": "Large",    "size": "1.3rem",  "fluid": { "min": "1.15rem", "max": "1.35rem" } },
				{ "slug": "x-large",  "name": "X-Large",  "size": "1.9rem",  "fluid": { "min": "1.55rem", "max": "2.1rem" } },
				{ "slug": "xx-large", "name": "XX-Large", "size": "2.9rem",  "fluid": { "min": "2.2rem", "max": "3.3rem" } },
				{ "slug": "display",  "name": "Display",  "size": "4.6rem",  "fluid": { "min": "2.7rem", "max": "5.2rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--figtree)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-1)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-3)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--accent-3)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--bricolage)",
					"fontWeight": "700",
					"lineHeight": "1.04",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "fontWeight": "800" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.2", "letterSpacing": "-0.01em" } },
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--accent-5)"
				},
				"typography": { "fontWeight": "700", "fontSize": "1rem", "fontFamily": "var(--wp--preset--font-family--figtree)" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.5rem", "right": "1.5rem" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-3)",
						"text": "var(--wp--preset--color--accent-5)"
					}
				}
			}
		}
	}
}
