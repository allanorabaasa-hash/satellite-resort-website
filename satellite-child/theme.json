{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "contrast",
					"name": "Ink",
					"color": "#14181F"
				},
				{
					"slug": "accent-1",
					"name": "Leaf green",
					"color": "#15803D"
				},
				{
					"slug": "accent-2",
					"name": "Sunny cream",
					"color": "#FFF6E0"
				},
				{
					"slug": "accent-3",
					"name": "Deep lake blue",
					"color": "#0E3B5E"
				},
				{
					"slug": "accent-4",
					"name": "Grey text",
					"color": "#4E5A63"
				},
				{
					"slug": "accent-5",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent-6",
					"name": "Hairline",
					"color": "#E6E1D3"
				},
				{
					"slug": "lake",
					"name": "Lake blue",
					"color": "#0A6FA8"
				},
				{
					"slug": "sun",
					"name": "Sunshine yellow",
					"color": "#FFB627"
				},
				{
					"slug": "gold-deep",
					"name": "Amber",
					"color": "#B45F00"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Cormorant Garamond",
					"slug": "cormorant",
					"fontFamily": "\"Cormorant Garamond\", Georgia, serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/CormorantGaramond-Variable.woff2"
							],
							"fontWeight": "300 700",
							"fontStyle": "normal",
							"fontFamily": "Cormorant Garamond",
							"fontDisplay": "swap"
						},
						{
							"src": [
								"file:./assets/fonts/CormorantGaramond-Variable-Italic.woff2"
							],
							"fontWeight": "300 700",
							"fontStyle": "italic",
							"fontFamily": "Cormorant Garamond",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"name": "Bricolage Grotesque",
					"slug": "bricolage",
					"fontFamily": "\"Bricolage Grotesque\", system-ui, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/BricolageGrotesque-Variable.woff2"
							],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Bricolage Grotesque",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"name": "Figtree",
					"slug": "figtree",
					"fontFamily": "Figtree, system-ui, sans-serif",
					"fontFace": [
						{
							"src": [
								"file:./assets/fonts/Figtree-Variable.woff2"
							],
							"fontWeight": "300 900",
							"fontStyle": "normal",
							"fontFamily": "Figtree",
							"fontDisplay": "swap"
						},
						{
							"src": [
								"file:./assets/fonts/Figtree-Variable-Italic.woff2"
							],
							"fontWeight": "300 900",
							"fontStyle": "italic",
							"fontFamily": "Figtree",
							"fontDisplay": "swap"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.3rem",
					"fluid": {
						"min": "1.15rem",
						"max": "1.35rem"
					}
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "1.9rem",
					"fluid": {
						"min": "1.55rem",
						"max": "2.1rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "XX-Large",
					"size": "2.9rem",
					"fluid": {
						"min": "2.2rem",
						"max": "3.3rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "4.6rem",
					"fluid": {
						"min": "2.7rem",
						"max": "5.2rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--figtree)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-1)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--gold-deep)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--accent-3)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cormorant)",
					"fontWeight": "600",
					"lineHeight": "1.05",
					"letterSpacing": "-0.005em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"fontWeight": "600"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.55rem",
					"lineHeight": "1.15",
					"letterSpacing": "0"
				}
			},
			"button": {
				"border": {
					"radius": "3px"
				},
				"color": {
					"background": "var(--wp--preset--color--sun)",
					"text": "var(--wp--preset--color--accent-3)"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "0.8rem",
					"fontFamily": "var(--wp--preset--font-family--figtree)",
					"textTransform": "uppercase",
					"letterSpacing": "0.14em"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--gold-deep)",
						"text": "var(--wp--preset--color--accent-5)"
					}
				}
			}
		}
	}
}
